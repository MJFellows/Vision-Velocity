# Vision Velocity frontend — environment template.
# Copy to .env.local (git-ignored) and fill in before `npm run dev`.

# --- Backend API (../backend — see its own README) --------------------------
# This frontend calls the Next.js backend's API routes for everything that
# needs auth, validation, or audit logging (login, admin CRUD, signup). Point
# this at wherever that backend is actually running.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

