# Vision Velocity backend — environment template.
# Copy to .env.local (git-ignored) and fill in real values before running
# `npm run dev`. Never commit .env.local, and never expose
# SUPABASE_SERVICE_ROLE_KEY to the client bundle (it must only ever be read
# in server-side code — API routes, middleware — never in a "use client"
# component or anything prefixed NEXT_PUBLIC_).

# --- Supabase ---------------------------------------------------------------
# Project: vision-velocity (ap-southeast-2 / Sydney)
NEXT_PUBLIC_SUPABASE_URL=https://kajhrbwxlzulqqissvwl.supabase.co

# Publishable/anon key — safe to expose to the browser. Pull the current
# value from Supabase Dashboard → Project Settings → API (or ask Claude to
# fetch it again via the Supabase MCP tools).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tkAXi-MfFMWeixVtOro-jw_xBMgLrEY

# Service role key — SECRET. Server-side only. Get this from Supabase
# Dashboard → Project Settings → API → service_role. Bypasses RLS entirely,
# so it is used sparingly in this codebase (see lib/supabase.ts).
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-supabase-dashboard

# --- CORS --------------------------------------------------------------------
# The origin(s) allowed to call these API routes from a browser. Comma-
# separate multiple origins (e.g. production + staging). No trailing slash.
CLIENT_APP_URL=http://localhost:3001

# --- Rate limiting -------------------------------------------------------
# In-memory rate limiter defaults (see utils/rateLimit.ts). Fine for local
# dev and a single-instance deployment; see that file's header comment for
# the production caveat on serverless/multi-instance platforms (Vercel).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# --- Bunnings Activities Officer portal (Task 3.2) ---------------------------
# Signs/verifies the short-lived AO session token issued after a magic link
# is used (see app/api/bunnings/activities-officer/{auth,events}). Any long
# random string; must match between deploys for existing sessions to keep
# verifying. Not the same secret as Supabase's own JWT signing.
JWT_SECRET=replace-with-a-long-random-string

# Used to build the magic-link URL sent to an AO (defaults to empty, which
# produces a relative URL — set this in any real deployment).
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Email (Task 3.3). Signup still succeeds if these are unset; emails are skipped/failed and logged.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-resend-api-key
NEXT_PUBLIC_EMAIL_FROM=noreply@visionvelocity.com.au
NEXT_PUBLIC_EMAIL_REPLY_TO=hello@visionvelocity.com.au
# Comma-separated addresses that receive "new charity signup" notifications
ADMIN_NOTIFICATION_EMAILS=
ENABLE_EMAIL_LOGGING=false
# Public URL of THIS backend, used to build open-tracking pixel and click-tracking links
TRACKING_BASE_URL=http://localhost:3000
